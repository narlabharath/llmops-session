# =============================================================================
# llmops-session — environment template
#
# 1. Copy this file to `.env` in the same directory.
# 2. Paste your real API key into the relevant *_API_KEY line.
# 3. NEVER commit `.env`. It is already in .gitignore.
# 4. NEVER paste API keys into chat, screenshots, or anywhere shareable.
# =============================================================================

# --- Primary backend selection -----------------------------------------------
# One of: anthropic | openai | gemini | ollama | mock
LLM_PROVIDER=anthropic

# --- Anthropic (default for this session) ------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenAI (alternative) ----------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini (alternative) ---------------------------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (local models) ---------------------------------------------------
# Legacy `/v1` values are still tolerated and normalized by the provider code.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Mock provider (tests / offline smoke checks) ----------------------------
MOCK_MODEL=mock-model-v1

# --- Local pieces (no keys needed) -------------------------------------------
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE=chroma
CHROMA_PATH=./data/chroma

# --- Observability -----------------------------------------------------------
TRACE_MODE=local
